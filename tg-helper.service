[Unit]
Description=TG WS Proxy authenticated helper
Documentation=https://github.com/byShadow64/tg-proxy/blob/main/docs/RU/Helper.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=tg-helper
Group=tg-helper
WorkingDirectory=/opt/tg-helper
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/tg-helper/venv/bin/python /opt/tg-helper/helper_server.py --bind 0.0.0.0 --secure-port 8444 --legacy-port 8443 --tls-cert /etc/tg-helper/server.crt --tls-key /etc/tg-helper/server.key --token-file /etc/tg-helper/token --pairing-store /var/lib/tg-helper/pairing.sqlite3
StateDirectory=tg-helper
StateDirectoryMode=0700
ReadWritePaths=/var/lib/tg-helper
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/tg-helper
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
CapabilityBoundingSet=
LimitNOFILE=1024
TasksMax=300

[Install]
WantedBy=multi-user.target
